# Environment Mode ('development' or 'production')
APP_ENV=development

# Database Connection
# Local SQLite (Development): sqlite:///./documind.db
# Neon PostgreSQL (Production): postgresql://<user>:<password>@<neon-host>.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./documind.db

# JWT Authentication
# In production, generate a secure random string (e.g. `openssl rand -hex 32`)
SECRET_KEY=change-this-secret-key-in-production-documind-key-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google Gemini API
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# Storage Paths
# Local Development: storage/uploads, storage/chroma_db
# Render Persistent Disk: /var/data/uploads, /var/data/chroma
UPLOAD_DIR=storage/uploads
CHROMA_DB_DIR=storage/chroma_db

# File Upload Constraints
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf

# CORS Allowed Origins (comma-separated without trailing slashes)
# Local: http://localhost:5173
# Production: https://your-documind-frontend.vercel.app
CORS_ORIGINS=http://localhost:5173
